rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is an Administrator
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "dimabinnewportal@gmail.com" ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    // Helper function to check if user is a Lecturer
    function isLecturer() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "lecturer"
      );
    }

    // System Settings & Active Academic Session
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Academic Sessions Registry
    match /academic_sessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Session Rollover Audit History
    match /session_rollovers/{rolloverId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activity Logs
    match /hgs_activity_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Courses & Curriculum Catalogue
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Semester-Specific Course Offerings
    match /semester_course_offerings/{offeringId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registration Window Settings
    match /registration_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Course Allocations (Semester & Session Specific)
    match /course_allocations/{allocId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Course Registrations (Semester-specific student records)
    match /course_registrations/{regId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.studentUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        (resource.data.studentUid == request.auth.uid || resource.data.userId == request.auth.uid) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'reviewedBy', 'reviewedAt', 'reviewNotes']) || resource.data.status == 'returned')
      );
      allow delete: if isAdmin();
    }

    // Examination & CA Results (Protected academic grading)
    match /results/{resultId} {
      // Students can read their own published/approved results or published CA
      // Admins and Lecturers can read course score sheets
      allow read: if isAuthenticated() && (
        isAdmin() || isLecturer() ||
        resource.data.status == "approved" ||
        resource.data.status == "published" ||
        resource.data.caPublished == true
      );
      // Admins have full write/approve authority
      // Lecturers can create or submit grades, but CANNOT self-approve or publish final results
      allow write: if isAdmin() || (
        isLecturer() &&
        request.resource.data.status != "approved" &&
        request.resource.data.status != "published" &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedBy', 'reviewedAt'])
      );
    }

    // CBT Assessments & Quizzes
    match /cbt_assessments/{asmtId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isLecturer();
    }

    // CBT Submissions & Attempts
    match /cbt_submissions/{subId} {
      // Students can read only their own submissions; faculty/admin can view for assessment grading
      allow read: if isAuthenticated() && (
        isAdmin() || isLecturer() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.studentUid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated();
      // Students can update only while attempt is in_progress, and CANNOT tamper with final scores or release status
      allow update: if isAdmin() || isLecturer() || (
        isAuthenticated() &&
        (resource.data.studentId == request.auth.uid || resource.data.studentUid == request.auth.uid || resource.data.userId == request.auth.uid) &&
        resource.data.status == "in_progress" &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['autoScore', 'totalScore', 'grade', 'percentage', 'markingStatus', 'resultsReleased'])
      );
      allow delete: if isAdmin();
    }

    // Users & Roles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Study Centres
    match /studyCentres/{centreId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
